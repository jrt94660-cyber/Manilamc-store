NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/manilamc
# Set to the exact deployed storefront origin, e.g. https://YOURNAME.github.io
FRONTEND_ORIGIN=https://YOURNAME.github.io

# PayMongo test key first. Use live key only after successful sandbox testing.
PAYMONGO_SECRET_KEY=sk_test_REPLACE_ME
PAYMONGO_WEBHOOK_SECRET=whsk_REPLACE_ME
PAYMONGO_SUCCESS_URL=https://YOUR-STOREFRONT-URL/payment-success.html
PAYMONGO_CANCEL_URL=https://YOUR-STOREFRONT-URL/payment-cancelled.html

# Random long secret used by the admin API. Never commit the real value.
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Minecraft RCON. Enable only after setting up RCON securely.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=

# Commands are executed by the backend only after verified payment/admin approval.
# {player}, {rank}, {key}, and {quantity} are substituted after strict validation.
RANK_COMMAND_TEMPLATE=lp user {player} parent set {rank}
KEY_COMMAND_TEMPLATE=
